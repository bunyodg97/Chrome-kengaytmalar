Windows Registry Editor Version 5.00

; Xavfsiz Bola: Chrome himoyasini kuchaytirish
; Inkognito rejimi, mehmon rejimi va yangi profil qo'shish o'chiriladi.
; Ishga tushirish: faylni ikki marta bosing (administrator huquqi kerak), keyin Chrome ni qayta oching.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"IncognitoModeAvailability"=dword:00000001
"BrowserGuestModeEnabled"=dword:00000000
"BrowserAddPersonEnabled"=dword:00000000
