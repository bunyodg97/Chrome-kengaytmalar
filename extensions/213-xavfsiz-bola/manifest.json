{
  "manifest_version": 3,
  "name": "Xavfsiz Bola — ota-ona nazorati",
  "short_name": "Xavfsiz Bola",
  "version": "1.0.0",
  "description": "Kattalar va qimor saytlarini bloklaydi, YouTube/Instagram/TikTok uchun kunlik vaqt limiti, uxlash vaqti, PIN bilan himoyalangan ota-ona paneli.",
  "author": "Bunyodg97",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Xavfsiz Bola" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "incognito": "spanning",
  "permissions": ["storage", "alarms", "tabs", "idle", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "adult", "enabled": true, "path": "rules/adult.json" },
      { "id": "gambling", "enabled": true, "path": "rules/gambling.json" },
      { "id": "safesearch", "enabled": true, "path": "rules/safesearch.json" }
    ]
  },
  "web_accessible_resources": [
    { "resources": ["blocked.html", "blocked.js", "common.js", "sites.js", "style.css", "icons/*"], "matches": ["<all_urls>"] }
  ]
}
