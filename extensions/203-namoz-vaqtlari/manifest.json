{
  "manifest_version": 3,
  "name": "Namoz vaqtlari — O'zbekiston",
  "short_name": "Namoz vaqtlari",
  "version": "1.1.0",
  "description": "Brauzer tepasida keyingi namozgacha qolgan vaqt. O'zbekiston shaharlari, eslatmalar, internetsiz ishlaydi.",
  "author": "Bunyodg97",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Namoz vaqtlari",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "geolocation",
    "contextMenus"
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}