{
  "manifest_version": 3,
  "name": "Toza PDF — maqolani reklamasiz saqlash",
  "short_name": "Toza PDF",
  "version": "1.0.0",
  "description": "Maqolani reklama, menyu va keraksiz qismlarsiz chiroyli PDF qilib saqlaydi. Shrift, rasmlar, keraksiz bloklarni o'chirish.",
  "author": "Bunyodg97",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Toza PDF yaratish" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" } } }
}
