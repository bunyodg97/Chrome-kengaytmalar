{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "1.1.0",
  "description": "__MSG_desc__",
  "author": "Bunyodg97",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://uzum.uz/*",
    "https://*.uzum.uz/*",
    "https://www.olx.uz/*",
    "https://olx.uz/*",
    "https://olcha.uz/*",
    "https://*.olcha.uz/*",
    "https://alifshop.uz/*",
    "https://*.alifshop.uz/*",
    "https://mediapark.uz/*",
    "https://*.mediapark.uz/*",
    "https://texnomart.uz/*",
    "https://*.texnomart.uz/*",
    "https://asaxiy.uz/*",
    "https://*.asaxiy.uz/*",
    "https://cbu.uz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://uzum.uz/*",
        "https://www.olx.uz/*",
        "https://olx.uz/*",
        "https://olcha.uz/*",
        "https://alifshop.uz/*",
        "https://mediapark.uz/*",
        "https://texnomart.uz/*",
        "https://asaxiy.uz/*"
      ],
      "js": [
        "ru.js",
        "about-cs.js",
        "page.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "default_locale": "uz"
}