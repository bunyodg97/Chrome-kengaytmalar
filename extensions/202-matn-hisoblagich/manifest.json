{
  "manifest_version": 3,
  "name": "Matn Hisoblagich — belgi, so'z, SMS",
  "short_name": "Matn Hisoblagich",
  "version": "1.0.0",
  "description": "Belgilar, so'zlar, gaplar, o'qish vaqti va nechta SMS bo'lishini hisoblaydi. O'zbekcha ʻ belgisi SMS narxini oshirishini ko'rsatadi. Saytdagi matn maydonlarida jonli hisoblagich.",
  "author": "Bunyodg97",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Matn Hisoblagich"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "ru.js",
        "about-cs.js",
        "count.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}