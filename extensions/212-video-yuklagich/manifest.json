{
  "manifest_version": 3,
  "name": "Video Yuklagich — saytdagi videolarni saqlash",
  "short_name": "Video Yuklagich",
  "version": "1.0.0",
  "description": "Saytdagi ochiq videolarni (MP4, WebM, HLS) topib yuklab oladi. YouTube, Netflix kabi DRM bilan himoyalangan saytlarda ISHLAMAYDI.",
  "author": "Bunyodg97",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Yuklagich"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "downloads",
    "declarativeNetRequestWithHostAccess",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "ru.js",
        "about-cs.js",
        "blocked.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}