{
  "manifest_version": 3,
  "name": "Rasm Saqlovchi — JPG/PNG/WebP",
  "short_name": "Rasm Saqlovchi",
  "version": "1.0.0",
  "description": "Istalgan rasmni JPG, PNG yoki WebP qilib saqlang. O'lcham va sifatni o'zgartirish, sahifadagi barcha rasmlarni ZIP qilib yuklab olish.",
  "author": "Bunyodg97",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rasm Saqlovchi"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "scripting",
    "offscreen",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}