{
  "manifest_version": 3,
  "name": "Diqqat — fokus rejimi",
  "short_name": "Diqqat",
  "version": "1.1.0",
  "description": "Ish vaqtida ijtimoiy tarmoqlar va chalg'ituvchi saytlarni bloklaydi. Pomodoro taymer, ovozli signal, ish jadvali, statistika.",
  "author": "Bunyodg97",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Diqqat"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "notifications",
    "offscreen",
    "declarativeNetRequestWithHostAccess",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "common.js",
        "style.css",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}