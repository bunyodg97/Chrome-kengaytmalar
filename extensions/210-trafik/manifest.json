{
  "manifest_version": 3,
  "name": "Trafik Hisoblagich — qaysi sayt qancha MB",
  "short_name": "Trafik",
  "version": "1.0.0",
  "description": "Har bir sayt qancha internet trafik sarflaganini ko'rsatadi. Kunlik va oylik limit, ogohlantirish. Mobil internet uchun.",
  "author": "Bunyodg97",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Trafik Hisoblagich" },
  "background": { "service_worker": "background.js" },
  "permissions": ["webRequest", "storage", "tabs", "notifications", "alarms"],
  "host_permissions": ["<all_urls>"]
}
